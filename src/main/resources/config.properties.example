# MySQL Database
db.url=jdbc:mysql://localhost:3306/elearning_system
db.user=root
db.password=your_db_password

# Gmail SMTP
email.address=your_email@gmail.com
email.password=your_gmail_app_password

# Google OAuth
google.client_id=your_google_client_id
google.client_secret=your_google_client_secret

# Facebook OAuth
facebook.app_id=your_facebook_app_id
facebook.app_secret=your_facebook_app_secret

# Firebase Authentication
firebase.api_key=your_firebase_api_key

# Google Gemini API
gemini.api_key=your_gemini_api_key
